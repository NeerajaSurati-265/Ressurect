# Copy to .env.local and adjust. Nothing here is secret.
# true = replay contracts/mock-scenarios.json in the browser; false = call the real API.
VITE_USE_MOCK=true
# Base URL of the Resurrect API (Lambda function URL). Placeholder until the backend exists.
VITE_API_BASE_URL=http://localhost:9999
# Mock only: seconds an "alive" resurrection lives before it expires (default 1200 = 20 minutes).
# VITE_MOCK_LIFETIME_S=60
